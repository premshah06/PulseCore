# Version control
.git
.gitignore

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
*.egg-info
.eggs
dist/
build/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Node / frontend (built separately)
frontend/node_modules/
frontend/.next/
frontend/out/

# ML artefacts — mounted as a volume at runtime, not baked into images
# (uncomment if you want to exclude them from the build context entirely)
# ml/models/

# Environment files — never bake secrets into images
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# Docker
docker-compose.override.yml

# Logs
*.log
logs/
