# PulseCore — copy this to .env before running `make up`
# All values shown are safe defaults for local development.

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_TOPIC=pulse.events                # Kafka topic all producers write to
KAFKA_GROUP_ID=pulsecore-consumer       # Consumer group ID
KAFKA_EXTERNAL_PORT=9092                # Host port mapped to the Kafka broker
KAFKA_NUM_PARTITIONS=3                  # Partitions per topic
KAFKA_LOG_RETENTION_HOURS=168           # 7-day log retention

# ── MongoDB replica set ───────────────────────────────────────────────────────
MONGO_APP_USER=pulse                    # MongoDB application username
MONGO_APP_PASS=pulse                    # MongoDB application password
MONGO_PORT_PRIMARY=27017                # Host port for mongo1 (primary)
MONGO_PORT_SECONDARY1=27018             # Host port for mongo2
MONGO_PORT_SECONDARY2=27019             # Host port for mongo3

# Connection string for services running OUTSIDE Docker (Compass, local dev)
MONGODB_URL=mongodb://pulse:pulse@localhost:27017/pulsecore?authSource=admin&directConnection=true

# Connection string for full replica-set access from host
# MONGODB_URL=mongodb://pulse:pulse@localhost:27017,localhost:27018,localhost:27019/pulsecore?replicaSet=rs0&authSource=admin

# MongoDB Atlas (production)
# MONGODB_URL=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/pulsecore?retryWrites=true&w=majority

# ── Inference sidecars ────────────────────────────────────────────────────────
INFERENCE_INFRA_PORT=8001               # Host port for infra sidecar
INFERENCE_ECOMMERCE_PORT=8002           # Host port for ecommerce sidecar
INFERENCE_IOT_PORT=8003                 # Host port for iot sidecar

# ── Consumer ──────────────────────────────────────────────────────────────────
WINDOW_SECONDS=60                       # Rolling aggregation window
LAG_THRESHOLD=1000                      # Warn when consumer lag exceeds this
INFERENCE_TIMEOUT_MS=500                # Per-sidecar HTTP timeout in ms
API_INTERNAL_URL=http://api:8000        # Internal FastAPI URL (Docker network)
INTERNAL_SECRET=change-me-in-production # Shared secret for /internal/broadcast
INFERENCE_URL_INFRA=http://inference-infra:8001
INFERENCE_URL_ECOMMERCE=http://inference-ecommerce:8002
INFERENCE_URL_IOT=http://inference-iot:8003

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8000                           # Host port for FastAPI backend
ALLOWED_ORIGINS=http://localhost:3000   # CORS allowed origins (comma-separated)

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_PORT=3000                      # Host port for Next.js dashboard
NEXT_PUBLIC_API_URL=http://localhost:8000   # Browser → API base URL
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws  # Browser → WebSocket URL

# ── Producers ─────────────────────────────────────────────────────────────────
PRODUCER_INFRA_EPS=5.0                  # infra events per second
PRODUCER_ECOMMERCE_EPS=3.0              # ecommerce events per second
PRODUCER_IOT_EPS=4.0                    # iot events per second
